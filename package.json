{
  "name": "csu-console-desktop",
  "version": "0.4.0-alpha.1",
  "private": true,
  "description": "Local-first MSX portfolio management for CSA managers",
  "main": "dist-main/main/index.js",
  "author": "Moim Hossain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MoimHossain/msxpert.git"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:updates:smoke": "node scripts/smoke-updates.cjs",
    "clean:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-release-artifacts.ps1",
    "package": "npm run clean:release && npm run build && electron-builder --win nsis --publish never",
    "package:signed": "npm run clean:release && npm run build && electron-builder --config electron-builder.signed.cjs --win nsis --publish never",
    "package:test": "npm run clean:release && npm run build && electron-builder --config electron-builder.test.cjs --win nsis --publish never",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "checksums": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/write-checksums.ps1",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@azure/msal-node": "5.5.0",
    "electron-updater": "6.8.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.7.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.moimhossain.csuconsole",
    "productName": "CSU Console",
    "artifactName": "CSU-Console-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "package.json",
      {
        "from": "prds",
        "to": ".",
        "filter": ["THIRD-PARTY-NOTICES.md"]
      }
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "MoimHossain",
      "repo": "msxpert",
      "private": false,
      "releaseType": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "Moim Hossain"
      },
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=22"
  }
}
